{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "86-it",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "Kitchen" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kitchen"] }],
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
  // Secret (not in this file): ASSEMBLYAI_API_KEY
  //   local:  .dev.vars
  //   prod:   npx wrangler secret put <NAME>
}
